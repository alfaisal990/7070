FROM python:3.10-slim

WORKDIR /app

# Install system dependencies needed for compiling packages
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY . .

# Set PYTHONPATH environment variable so imports resolve properly
ENV PYTHONPATH=/app
ENV PHOENIX_WORKSPACE=/app

EXPOSE 8000

CMD ["uvicorn", "ai_project.api.main:app", "--host", "0.0.0.0", "--port", "8000"]
