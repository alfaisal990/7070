# Phoenix AI - Environment Configuration
# Copy this file to .env and update values for your environment

# ── Security ──
SECRET_KEY=phoenix-dev-secret-change-in-production-2024
JWT_SECRET_KEY=phoenix-jwt-secret-change-in-production-2024
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ── CORS ──
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000

# ── Database ──
DATABASE_URL=sqlite:///ai_project/memory/phoenix.db

# ── Rate Limits ──
RATE_LIMIT_CHAT=20
RATE_LIMIT_UPLOAD=5
RATE_LIMIT_SANDBOX=10

# ── Environment ──
ENVIRONMENT=development
DEBUG=false
